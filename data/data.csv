  yang-version 1.1;
  namespace ""urn:ietf:params:xml:ns:yang:ietf-schc"";
  prefix schc;
  organization
    ""IETF IPv6 over Low Power Wide-Area Networks (lpwan) Working
     Group"";
  contact
    ""WG Web:   <https://datatracker.ietf.org/wg/lpwan/about/>
     WG List:  <mailto:lp-wan@ietf.org>
